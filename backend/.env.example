# ==========================================
# SPHEREx Sky Viewer - Backend Environment Configuration
# ==========================================

# Entorno y Depuración
SPHEREX_DEBUG=False
SPHEREX_PORT=8000
SPHEREX_HOST=0.0.0.0

# CORS (Orígenes permitidos separados por coma, o ["*"] en desarrollo)
# SPHEREX_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Directorios de Almacenamiento (Opcional: defaults a backend/data/cache)
# SPHEREX_CACHE_DIR=./data/cache
# SPHEREX_PRECOMPUTED_DIR=../frontend/public/data

# Parámetros de IRSA / NASA IPAC
SPHEREX_IRSA_TIMEOUT_SECONDS=60.0
SPHEREX_IRSA_MAX_RETRIES=4
SPHEREX_MAX_CONCURRENT_DOWNLOADS=3

# Configuración de Cuadros y Detectores
SPHEREX_DEFAULT_DETECTOR=D2
SPHEREX_DEFAULT_FOV=0.1
SPHEREX_MAX_FRAMES=24
