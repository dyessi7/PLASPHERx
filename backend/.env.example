# ==========================================
# SPHEREx Sky Viewer - Backend Environment Configuration
# ==========================================

# Environment and Debugging
SPHEREX_DEBUG=False
SPHEREX_PORT=8000
SPHEREX_HOST=0.0.0.0

# CORS origins as JSON list. Add the production frontend domain here.
SPHEREX_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://my-frontend.example.com"]

# Persistent cache (persistent volume recommended in production)
# SPHEREX_CACHE_DIR=./data/cache
SPHEREX_CACHE_MAX_BYTES=2147483648
SPHEREX_METADATA_CACHE_TTL_SECONDS=600
SPHEREX_SEARCH_CACHE_TTL_SECONDS=600

# IRSA / NASA IPAC Network Parameters
SPHEREX_IRSA_TIMEOUT_SECONDS=60.0
SPHEREX_IRSA_MAX_RETRIES=4
SPHEREX_MAX_CONCURRENT_DOWNLOADS=3

# Frames and Detector Configuration
SPHEREX_DEFAULT_DETECTOR=D2
SPHEREX_DEFAULT_FOV=0.1
SPHEREX_MAX_FRAMES=24
